NODE_ENV=development
PORT=8034
FRONTEND_URL=http://localhost:8033

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/issueflow?schema=public"

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Optional: required only when self-registering an ADMIN account
ADMIN_SECRET_CODE=change-me

# Optional: transactional email. When omitted, emails (invites/OTP) are
# printed to the API console so local flows still work.
# EMAIL_USER=
# EMAIL_PASSWORD=

# Optional: Web Push (leave empty to disable push subscription UI/endpoints)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
