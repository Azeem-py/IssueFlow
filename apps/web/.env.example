# Use the Vite dev proxy so auth cookies stay on the same origin.
VITE_API_URL=/api/v1

# Optional: signed Cloudinary uploads. When omitted, images are compressed
# client-side and stored as data URLs for local development.
# VITE_CLOUDINARY_CLOUD_NAME=
# VITE_CLOUDINARY_API_KEY=
# VITE_CLOUDINARY_API_SECRET=

# Optional: enables browser push notifications
# VITE_VAPID_PUBLIC_KEY=
